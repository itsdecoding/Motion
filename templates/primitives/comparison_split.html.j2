{% macro style() %}
.compare { flex: 1; display: flex; flex-direction: column; justify-content: center; gap: 32px; }
.compare .title { font-size: 68px; font-weight: 800; line-height: 1.02; letter-spacing: -0.03em; margin-bottom: 12px; }
.compare .card { border-radius: 28px; padding: 40px 44px 44px; display: flex; flex-direction: column; gap: 22px; transform-origin: 50% 0; }
.compare .old { background: var(--surface); }
.compare .new { background: var(--carbon); color: var(--paper); }
.compare .label { font-family: "Instrument Serif", serif; font-style: italic; font-size: 48px; line-height: 1; }
.compare .old .label { color: var(--muted); }
.compare .new .label { color: var(--highlight); }
.compare ul { list-style: none; display: flex; flex-direction: column; gap: 18px; }
.compare li { display: flex; align-items: flex-start; gap: 20px; font-size: 34px; line-height: 1.3; }
.compare .old li { color: var(--ink); }
.compare .mark { flex: none; width: 40px; height: 40px; margin-top: 2px; }
{% endmacro %}

{% macro point(side, index, text) %}
<li>
  <svg class="mark" viewBox="0 0 40 40" aria-hidden="true">
    {% if side == "old" %}
    <path d="M13 13 27 27M27 13 13 27" stroke="var(--negative)" stroke-width="4.5" stroke-linecap="round"/>
    {% else %}
    <circle cx="20" cy="20" r="18" fill="var(--highlight)"/>
    <path d="m12 20.5 5.5 5.5L28 15" fill="none" stroke="var(--carbon)" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
    {% endif %}
  </svg>
  <span data-qa="{{ side }}-{{ index }}">{{ text }}</span>
</li>
{% endmacro %}

{% macro markup(s) %}
<div class="compare">
  <h2 class="title" data-qa="title">{{ s.title }}</h2>
  {% for side, label, points in [("old", s.old_label, s.old_points), ("new", s.new_label, s.new_points)] %}
  <div class="card {{ side }}" id="{{ side }}-card">
    <p class="label" data-qa="{{ side }}-label">{{ label }}</p>
    <ul>{% for text in points %}{{ point(side, loop.index, text) }}{% endfor %}</ul>
  </div>
  {% endfor %}
</div>
{% endmacro %}

{% macro script(s) %}
const CARDS = ["old", "new"].map((side) => ({
  card: document.getElementById(`${side}-card`),
  start: S[`${side}_card`],
  points: [...document.querySelectorAll(`#${side}-card li`)].map((li, i) => ({
    mark: li.querySelector(".mark"), text: li.querySelector("span"), start: S[`${side}_points`][i],
  })),
}));
function stage(t) {
  for (const { card, start, points } of CARDS) {
    const p = spring(t - start);
    card.style.opacity = clamp(p);
    card.style.transform = `translateY(${(1 - p) * 48}px) scale(${0.96 + 0.04 * p})`;
    for (const pt of points) {
      const q = spring(t - pt.start, 320, 18);
      pt.mark.style.opacity = clamp(q);
      pt.mark.style.transform = `scale(${Math.max(0, q)})`;
      enter(pt.text, spring(t - pt.start - 0.04), 16);
    }
  }
  enter($("title"), spring(t - S.title), 40, 10);
}
{% endmacro %}
